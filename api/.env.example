# Leave GCP_PROJECT empty to run against local Firebase emulators with the Pub/Sub shim.
GCP_PROJECT=
REGION=asia-southeast1
PORT=8080
DEMO_MODE=true
WORKER_URL=http://localhost:8081
PUBLIC_WEB_URL=http://localhost:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
VERTEX_LOCATION=global
ROUTES_API_KEY=
PUBSUB_TOPIC_PINGS=pings
PUBSUB_TOPIC_BUS=bus-positions
PUBSUB_TOPIC_INCIDENTS=incidents
BQ_DATASET=commute
